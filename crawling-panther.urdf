      <inertia ixx="0.000062" ixy="0" ixz="0" iyy="0.000656" iyz="0" izz="0.000694" />
    </inertial>
  </link>

  <!-- LEG 2 (16.5 GRAM) -->
  <joint name="base_link_to_leg2" type="revolute">
