    </inertial>
  </link>

  <!-- LEG 1 (16.5 GRAM) -->
  <joint name="base_link_to_leg1" type="revolute">
    <parent link="hip1" />
    <child link="leg1" />
    <origin xyz="0.1 -0.405 -0.1" rpy="0 1.5707963267948966 0" />
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="leg1">
