<robot name="robot">
  <link name="base_footprint"></link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.5" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1.16 1.262 0.1" />
      </geometry>
      <material name="base_link-material">
        <color rgba="0.3139887133649649 0.9046611743890203 0.14702726648767014 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1.16 1.262 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="0.00800" ixy="0" ixz="0" iyy="0.00678" iyz="0" izz="0.01468" />
    </inertial>
  </link>

  <!-- BASE_LINK ÜSTÜNDE, ARKA KENARINDAN 0.12 M İÇERİDE DURAN SİMETRİK SABİT KUTU (200 GRAM) -->
  <joint name="base_link_to_extra_box" type="fixed">
    <parent link="base_link" />
    <child link="extra_box" />
    <!-- x = -0.285 (ön tarafın tam zıttı, arka taraftaki simetrik noktası) -->
    <origin xyz="-0.285 0 0.1" rpy="0 0 1.570796" />
  </joint>

  <link name="extra_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.65 0.35 0.1" />
      </geometry>
      <material name="extra_box_material">
        <color rgba="0.2 0.6 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.65 0.35 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.20" />
      <inertia ixx="0.00221" ixy="0" ixz="0" iyy="0.00721" iyz="0" izz="0.00908" />
    </inertial>
  </link>

  <!-- HIP 1 (6 GRAM) -->
  <joint name="base_link_to_hip1" type="revolute">
    <parent link="base_link" />
    <child link="hip1" />
    <origin xyz="0.365 -0.515 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="hip1">
    <visual>
      <origin xyz="-0.03 -0.185 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.49 0.3" />
      </geometry>
      <material name="hip1-material">
        <color rgba="0.008023192982520563 0.7304607400847158 0.5711248294565854 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.03 -0.185 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.49 0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.03 -0.185 0" rpy="0 0 0" />
      <mass value="0.006" />
      <inertia ixx="0.000165" ixy="0" ixz="0" iyy="0.000065" iyz="0" izz="0.000140" />
    </inertial>
  </link>

  <!-- HIP 2 (6 GRAM) -->
  <joint name="base_link_to_hip2" type="revolute">
    <parent link="base_link" />
    <child link="hip2" />
    <origin xyz="-0.365 -0.515 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="hip2">
    <visual>
      <origin xyz="0.03 -0.185 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.49 0.3" />
      </geometry>
      <material name="hip2-material">
        <color rgba="0.008023192982520563 0.7304607400847158 0.5711248294565854 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.03 -0.185 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.49 0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 -0.185 0" rpy="0 0 0" />
      <mass value="0.006" />
      <inertia ixx="0.000165" ixy="0" ixz="0" iyy="0.000065" iyz="0" izz="0.000140" />
    </inertial>
  </link>

  <!-- HIP 3 (6 GRAM) -->
  <joint name="base_link_to_hip3" type="revolute">
    <parent link="base_link" />
    <child link="hip3" />
    <origin xyz="0.365 0.515 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="hip3">
    <visual>
      <origin xyz="-0.03 0.18 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.49 0.3" />
      </geometry>
      <material name="hip3-material">
        <color rgba="0.008023192982520563 0.7304607400847158 0.5711248294565854 1" />
