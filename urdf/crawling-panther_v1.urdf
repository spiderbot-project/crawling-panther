      <inertia ixx="0.000022" ixy="0" ixz="0" iyy="0.000072" iyz="0" izz="0.000091" />
    </inertial>
  </link>

  <!-- HIP 1 -->
  <joint name="base_link_to_hip1" type="revolute">
    <parent link="base_link" />
    <child link="hip1" />
    <origin xyz="0.0365 -0.0515 0.01" rpy="0 0 0" />
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1" upper="1" velocity="5.0"/>
  </joint>

