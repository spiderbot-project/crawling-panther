<robot name="robot">
  <link name="base_footprint"></link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.116 0.1262 0.01" />
      </geometry>
      <material name="base_link-material">
        <color rgba="0.314 0.905 0.147 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.116 0.1262 0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.075" />
      <inertia ixx="0.000100" ixy="0" ixz="0" iyy="0.000085" iyz="0" izz="0.000184" />
    </inertial>
  </link>

  <joint name="base_link_to_extra_box" type="fixed">
    <parent link="base_link" />
    <child link="extra_box" />
    <origin xyz="-0.0285 0 0.01" rpy="0 0 1.570796" />
  </joint>

  <link name="extra_box">
